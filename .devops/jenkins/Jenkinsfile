pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME      = 'enterprise-backend'
        IMAGE_TAG       = "${BUILD_NUMBER}"

        KIND_CLUSTER    = 'enterprise-platform'
        KUBE_NAMESPACE  = 'enterprise-dev'
        DEPLOYMENT_NAME = 'backend-api'
        CONTAINER_NAME  = 'backend-api'

        KUBE_API_SERVER = 'https://enterprise-platform-control-plane:6443'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                dir('application/backend') {
                    sh '''
                        rm -rf .jenkins-venv

                        python3 -m venv .jenkins-venv
                        .jenkins-venv/bin/pip install -r requirements.txt
                        .jenkins-venv/bin/python -m pytest
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -f .devops/docker/Dockerfile \
                      application/backend
                '''
            }
        }

        stage('Load Image to kind') {
            steps {
                sh '''
                    kind load docker-image \
                      ${IMAGE_NAME}:${IMAGE_TAG} \
                      --name ${KIND_CLUSTER}
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k8s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        docker exec enterprise-platform-control-plane \
                          cat /etc/kubernetes/pki/ca.crt \
                          > "$WORKSPACE/kind-ca.crt"

                        kubectl config set-cluster enterprise-platform \
                          --server="${KUBE_API_SERVER}" \
                          --certificate-authority="$WORKSPACE/kind-ca.crt" \
                          --kubeconfig="$WORKSPACE/jenkins-kubeconfig"

                        kubectl config set-credentials jenkins-deployer \
                          --token="${K8S_TOKEN}" \
                          --kubeconfig="$WORKSPACE/jenkins-kubeconfig"

                        kubectl config set-context jenkins-deployer-context \
                          --cluster=enterprise-platform \
                          --user=jenkins-deployer \
                          --namespace="${KUBE_NAMESPACE}" \
                          --kubeconfig="$WORKSPACE/jenkins-kubeconfig"

                        kubectl config use-context jenkins-deployer-context \
                          --kubeconfig="$WORKSPACE/jenkins-kubeconfig"

                        KUBECONFIG="$WORKSPACE/jenkins-kubeconfig" \
                          kubectl set image \
                          deployment/${DEPLOYMENT_NAME} \
                          ${CONTAINER_NAME}=${IMAGE_NAME}:${IMAGE_TAG}

                        KUBECONFIG="$WORKSPACE/jenkins-kubeconfig" \
                          kubectl rollout status \
                          deployment/${DEPLOYMENT_NAME} \
                          --timeout=180s
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k8s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        KUBECONFIG="$WORKSPACE/jenkins-kubeconfig" \
                          kubectl get deployment/${DEPLOYMENT_NAME}

                        KUBECONFIG="$WORKSPACE/jenkins-kubeconfig" \
                          kubectl get pods -l app=backend-api
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'CI/CD pipeline failed. Check the failed stage.'
        }

        always {
            sh '''
                rm -f "$WORKSPACE/jenkins-kubeconfig"
                rm -f "$WORKSPACE/kind-ca.crt"
            '''
        }
    }
}