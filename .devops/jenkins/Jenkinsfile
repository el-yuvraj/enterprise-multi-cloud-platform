pipeline {
    agent any

    environment {
        IMAGE_NAME = 'enterprise-backend'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                dir('application/backend') {
                    sh '''
                        python3 -m venv .jenkins-venv
                        .jenkins-venv/bin/pip install -r requirements.txt
                        .jenkins-venv/bin/python -m pytest
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -f .devops/docker/Dockerfile \
                      application/backend
                '''
            }
        }
    }

    post {
        success {
            echo 'CI pipeline completed successfully.'
        }

        failure {
            echo 'CI pipeline failed. Check the failed stage.'
        }
    }
}